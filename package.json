{
  "name": "web-search",
  "version": "1.0.3",
  "description": "Chromium extension for on-page search with Russian morphology, annotations, reader mode, offline archives, dictionary, and QR tools",
  "private": true,
  "directories": {
    "lib": "lib",
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/reader-export.mjs && node tests/reader-export-copy.mjs && node tests/offline-archive.mjs && node tests/archive-journal.mjs && node tests/citation-formats.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppvikentiy/web-search.git"
  },
  "bugs": {
    "url": "https://github.com/ppvikentiy/web-search/issues"
  },
  "homepage": "https://github.com/ppvikentiy/web-search#readme",
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "search",
    "morphology",
    "russian",
    "annotations",
    "reader",
    "offline-archive",
    "gplv3"
  ],
  "author": "ppvikentiy",
  "license": "GPL-3.0-only",
  "type": "commonjs",
